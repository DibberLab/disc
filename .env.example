# Copy to .env on the droplet. docker-compose reads it automatically.

# Host port nginx proxies to. CONFIRM THIS IS FREE on the droplet before
# using it:  ss -ltnp | grep 8412
PORT_HOST=8412

# Accounts are created with scripts/create-user.js, not an env var — there
# is no signup form. Run it once per person, e.g.:
#   docker compose exec disc node scripts/create-user.js andy
# DG_WRITE_TOKEN is gone: real per-user login (see docs/API.md) replaced it.
