# Copy to .env on the droplet. docker-compose reads it automatically.

# Host port nginx proxies to. CONFIRM THIS IS FREE on the droplet before
# using it:  ss -ltnp | grep 8412
PORT_HOST=8412

# Leave blank for an open, no-login app (the current decision).
# Set it to a long random string to require X-DG-Token on every write:
#   openssl rand -hex 24
# If you set it, public/store.js has to send it too — see docs/DEPLOY.md.
DG_WRITE_TOKEN=
